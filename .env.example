# 이 파일을 복사해 프로젝트 루트에 .env를 만들고 값을 채운다. .env는 Git에 올리지 않는다.
# KEY=value 형식으로 따옴표 없이 쓴다.

# 필수
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상. 생성: openssl rand -base64 32
JWT_SECRET=
# Google AI Studio에서 발급한 Gemini API 키
GEMINI_API_KEY=

# 선택: 주석을 풀면 application.yml의 기본값 대신 쓴다
# DB_URL=jdbc:mysql://localhost:3306/bium
# JPA_DDL_AUTO=update
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# GEMINI_MODEL=gemini-2.5-flash-lite
# RECIPE_RECOMMENDATION_RATE_LIMIT=5
# RECIPE_RECOMMENDATION_GLOBAL_RATE_LIMIT=15
